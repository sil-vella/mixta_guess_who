# Flutter / Dart
mixta_flutter/build/
mixta_flutter/.dart_tool/
mixta_flutter/.flutter-plugins
mixta_flutter/.flutter-plugins-dependencies

# Logs / local tooling output
mixta_flask/tools/logger/*.log
cdp-output/

# Backups & snapshots (everything under these dirs + common backup suffixes)
**/backup/
**/backups/
# ROP01 local dumps (multi‑GB archives; must never be in git history going forward)
playbooks/rop01/backup/

# Local Postgres data dir (if created under mixta_flask — never commit)
mixta_flask/db_data/
**/*.bak
*.backup
*.old
*~
*.orig
*.sql.gz
*.sql.bz2
*.dump
*.dmp

# Bulk / downloaded celebrity faces (any file type; too large for typical git)
mixta_flask/plugins/game_plugin/modules/question_module/celeb_data/images/

