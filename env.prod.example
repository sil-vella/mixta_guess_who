# Copy to `.env.prod` at repo root (gitignored) and fill in real values.
# Used by: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_USER=mixta
MYSQL_PASSWORD=change_me_app
MYSQL_DB=mixta_game

# Flask (container + Gunicorn); must match docker-compose.prod.yml port mapping
FLASK_PORT=5002

# VPS only (docker-compose.guesswho.vps.yml): pre-built image from Hub; optional override
# MIXTA_FLASK_IMAGE=silvella/mixtagw_flask_app:latest

# Public site URL for absolute image URLs in API JSON (https avoids mixed-content on Flutter web).
# Set when nginx does not send X-Forwarded-Proto, or to pin a canonical host.
# PUBLIC_BASE_URL=https://guesswho.mixta.mt

# Optional: host port for MySQL if you need tools on the host (compose has it commented out)
# DB_PORT=3307
